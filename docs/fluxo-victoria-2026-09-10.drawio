<mxCell id="e8" value="VictorIA (lead conversa)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_inicio" target="evo_interessado"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="VictorIA (7 dados)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_interessado" target="evo_pre"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="Nei, após OK do Edu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_pre" target="evo_cadastro"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="Nei (12 dados)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_cadastro" target="evo_analise"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="Nei, após OK do Edu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_analise" target="evo_treinar"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="Nei (treinou)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_treinar" target="evo_login"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="Nei (1ª venda)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#1F4E8C;" edge="1" parent="lane_evo" source="evo_login" target="evo_vendendo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lane_victoria" value="🤖 VictorIA (webhook + prompt)" style="swimlane;horizontal=0;startSize=40;html=1;fillColor=#EBE5F9;strokeColor=#5B3FA6;fontColor=#5B3FA6;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="232" width="2528" height="340" as="geometry"/></mxCell>
<mxCell id="victoria_inicio" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Lead responde → webhook (Evo → Vercel)&lt;/li&gt;&lt;li&gt;Abertura: "Sou a VictorIA, da Track… já trabalham com crediário?"&lt;/li&gt;&lt;li&gt;Qualifica 1 pergunta por vez: crediário? quantas lojas? marcas?&lt;/li&gt;&lt;li&gt;Detecta bot/auto-reply (tenta furar, máx trocas) → 69 Bot Detectado&lt;/li&gt;&lt;li&gt;Opt-out real ("não quero") → OPT_OUT · só iPhone / não vende celular → NAO_QUALIFICADO&lt;/li&gt;&lt;li&gt;Fim de semana: responde normal (webhook nunca para)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="60" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_interessado" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;FASE 1 — coleta 7 dados no chat, um por vez: nome do sócio · CNPJ matriz (cedo) · telefone do sócio · nome da loja · região · nº de lojas · outra financeira?&lt;/li&gt;&lt;li&gt;CNPJ chega → checagens automáticas (ver Sistemas): DV inválido / não consta na Receita → NÃO pré-aprova&lt;/li&gt;&lt;li&gt;CNPJ já na base AIVA/Odres → mensagem oficial + transfere pro funil 19 (tag ODRES/UME)&lt;/li&gt;&lt;li&gt;CNPJ &amp;lt; 1 ano → NAO_QUALIFICADO + card vai pra 93&lt;/li&gt;&lt;li&gt;Sem sócio na Receita (QSA vazio) → segue igual a qualquer lead (regra 10/09: sem documentos, sem tag)&lt;/li&gt;&lt;li&gt;Objeções, taxa 12% × juros do cliente, nunca simula parcelas, nunca acusa golpe&lt;/li&gt;&lt;li&gt;7 dados completos → PRE_APROVACAO + aciona humano (qualificacao_inicial_completa)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="332" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_pre" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;FASE 2 — só tranquiliza: "estamos analisando, em breve retorno". Não pede dado, não promete prazo&lt;/li&gt;&lt;li&gt;Se o CNPJ tiver ≥ 3 lojas → tag IMPORTANTE (74) na opp&lt;/li&gt;&lt;li&gt;Alerta Nei + Aldo: pré-aprovação enviada&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="604" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_cadastro" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Entrada na etapa → HSM 29 "Complete o cadastro" reabre a janela; status volta a INTERESSADO com marcador de Fase 3&lt;/li&gt;&lt;li&gt;FASE 3 — coleta 5 dados: e-mail do sócio · faturamento anual · boleto mensal · localização das lojas · CNPJs adicionais (só se ≥ 2 lojas)&lt;/li&gt;&lt;li&gt;Dados sensíveis: explica o porquê, aceita "por alto"; recusa → aciona humano (receio_dados_sensiveis)&lt;/li&gt;&lt;li&gt;Trava anti-conclusão: sem os 5, nunca diz "cadastro completo"&lt;/li&gt;&lt;li&gt;12 dados completos → CADASTRO_RECEBIDO + HubSpot + registro do CNPJ + alerta ✅ (cadastro_completo)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="876" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_analise" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Entrada na etapa → HSM 34 (aprovação) com o link do onboarding retail-onboarding-hub + biometria (CAF)&lt;/li&gt;&lt;li&gt;FASE 4 — acompanha: "conseguiu acessar? concluiu a biometria?"&lt;/li&gt;&lt;li&gt;Qualquer erro → PEDE O PRINT primeiro (regra 08/09) · dificuldade → aciona humano (dificuldade_onboarding_caf)&lt;/li&gt;&lt;li&gt;Lead diz que concluiu → aciona humano (cadastro_caf_confirmado)&lt;/li&gt;&lt;li&gt;Nunca reenvia o link sozinha; status fica EM_ANALISE_AIVA (só o time muda)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="1148" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_treinar" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Entrada na etapa → HSM 69 "Treinamento completo": link do Meet (seg/qui 9h30), Drive de materiais, cadastro de acessos&lt;/li&gt;&lt;li&gt;Regra de acessos (27/08): um usuário por loja; logins liberados pela AIVA após o treinamento&lt;/li&gt;&lt;li&gt;Vacina da reprovação antes das primeiras consultas&lt;/li&gt;&lt;li&gt;🔒 Trava/desbloqueio de aparelho → só pelo Live Chat (Track não tem autoridade)&lt;/li&gt;&lt;li&gt;Erro na tela → pede print → abre chamado pro Nei&lt;/li&gt;&lt;li&gt;Loja nova no meio da conversa → aciona Nei (filial/correção cadastral)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="1420" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_login" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Espelha status LOGIN no painel (sync em tempo real)&lt;/li&gt;&lt;li&gt;Orienta primeiro acesso, operação Flexfone, consulta a distância × finalização presencial&lt;/li&gt;&lt;li&gt;Boleto do cliente: quem emite é a LOJA, dentro do Flexfone — vídeo "Como emitir boleto"&lt;/li&gt;&lt;li&gt;⛔ Regra 10/09: cliente novo = só AIVA no Flexfone; Odres congelada (segue só em lojas já abertas com ela)&lt;/li&gt;&lt;li&gt;Links úteis por tema (portal, treinamento, 2ª via do cliente)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="1692" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="victoria_vendendo" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Entrada na etapa → liga o relógio da consultoria ([CONSULTORIA_INICIO]) — não fala nada na hora&lt;/li&gt;&lt;li&gt;FASE 5 — consultoria de vendas: playbook (preparar a loja · do CPF ao fechamento · aproveitar cada real · atrair fluxo)&lt;/li&gt;&lt;li&gt;Suporte pós-venda: A) lojista (plataforma/financeiro) · B) cliente final (parcelamento) · C) como fazer (Drive)&lt;/li&gt;&lt;li&gt;Objeção nº 1 "a AIVA não aprova" · prioriza autonomia do lojista&lt;/li&gt;&lt;li&gt;Loja diz que nunca operou → 🚩 alerta Nei (loja_finalizada_sem_operar)&lt;/li&gt;&lt;li&gt;Repasse solicitado → planilha Repasses · CS acionamento → /atendimento&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#5B3FA6;fontFamily=Helvetica;" vertex="1" parent="lane_victoria"><mxGeometry x="1964" y="14" width="250" height="312" as="geometry"/></mxCell>
<mxCell id="saida_0" value='&lt;b&gt;53 · Interessado (Sem resposta)&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;automação 98&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;auto-descarte (Início +15d) · régua-saída · SEM_RESPOSTA +30d → DESCARTADO&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="14" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="saida_1" value='&lt;b&gt;69 · Bot Detectado&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;automação 100&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;VictorIA detectou auto-resposta; reativação recomeça do zero&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="67" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="saida_2" value='&lt;b&gt;93 · Lojas menos de 01 Ano&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;automação 101&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;CNPJ &amp;lt; 1 ano na Receita → NAO_QUALIFICADO (regra 08/09)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="120" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="saida_3" value='&lt;b&gt;19 · Funil 19 · Odres / UME&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;transferência&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;CNPJ já na base AIVA/Odres → mensagem oficial + tag ODRES/UME · sdr_leads apaga o lead&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="173" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="saida_4" value='&lt;b&gt;OPT_OUT · LGPD&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;webhook&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;"não quero mais" → OPT_OUT · pedido de exclusão → confirma, apaga dados, guarda só o telefone&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="226" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="saida_5" value='&lt;b&gt;DESCARTADO / NAO_QUALIFICADO&lt;/b&gt; &lt;span style="font-size:8px;color:#8C2F2F"&gt;terminal&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:8px"&gt;Descarte manual do Nei é respeitado; status terminais nunca são revividos pelo sync&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=3;fillColor=#F6DEDA;strokeColor=#8C2F2F;fontSize=9;" vertex="1" parent="lane_victoria"><mxGeometry x="2236" y="279" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="lane_humano" value="👤 Humanos — Nei · Edu (AIVA) · Aldo" style="swimlane;horizontal=0;startSize=40;html=1;fillColor=#FBEBC8;strokeColor=#8A5200;fontColor=#8A5200;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="584" width="2528" height="190" as="geometry"/></mxCell>
<mxCell id="humano_inicio" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Aldo dispara 150 números/dia (painel Campanha ou disparar-fila.mjs), seg–sex&lt;/li&gt;&lt;li&gt;Filtro no disparo: pula bot, opt-out, lead já em cadência, base AIVA&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="60" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_interessado" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Nei entra quando: +10 lojas · pede contrato · irritado · dúvida técnica/jurídica · já cliente AIVA · confirmar_contato&lt;/li&gt;&lt;li&gt;Reengajamento esgotado (3×) → lead sinalizado; descartar é decisão do Nei&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="332" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_pre" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Edu (AIVA) analisa a pré-aprovação pela planilha, em até 24h&lt;/li&gt;&lt;li&gt;Aprovou → Nei move o card 54 → 49 (Cadastro Recebido)&lt;/li&gt;&lt;li&gt;Reprovou → descarte (Nei marca no Evo)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="604" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_cadastro" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Nei confere no /registros e move o card 49 → 50 (Em Análise)&lt;/li&gt;&lt;li&gt;Cobrança esgotada (3 toques) → escala pro Nei uma vez&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="876" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_analise" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Edu (AIVA) analisa o onboarding + CAF: aprova ou reprova&lt;/li&gt;&lt;li&gt;Aprovou → Nei move 50 → 70 (Treinar) · Reprovou → descarte&lt;/li&gt;&lt;li&gt;Print do erro chega no chamado (📷) pro Nei identificar&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="1148" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_treinar" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Nei dá o treinamento (segundas e quintas, 9h30, mesmo link)&lt;/li&gt;&lt;li&gt;Nei confirma acesso/treino e move 70 → 71 (Login)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="1420" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_login" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;AIVA libera o login da loja&lt;/li&gt;&lt;li&gt;Nei acompanha a primeira venda e move 71 → 51&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="1692" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="humano_vendendo" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Nei acompanha /desempenho (Portal Parceiros AIVA) e /atendimento (CS)&lt;/li&gt;&lt;li&gt;Comissão por loja ativada (importação mensal UME)&lt;/li&gt;&lt;li&gt;⚠️ Etapa 51 não aceita mover card pela API (só na mão)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#8A5200;fontFamily=Helvetica;" vertex="1" parent="lane_humano"><mxGeometry x="1964" y="14" width="250" height="162" as="geometry"/></mxCell>
<mxCell id="lane_rotinas" value="⏰ Rotinas automáticas (crons)" style="swimlane;horizontal=0;startSize=40;html=1;fillColor=#D6F0EC;strokeColor=#0F6E63;fontColor=#0F6E63;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="786" width="2528" height="270" as="geometry"/></mxCell>
<mxCell id="rotinas_inicio" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;HSM 41 "AIVA Dia 1" (D+0) → lead INICIO + card 66&lt;/li&gt;&lt;li&gt;Régua D+3 (HSM 35) · D+7 (HSM 38) · D+14 (HSM 39) — ⏸ PAUSADA (17/08; religada e pausada de novo em 10/09): ~4.100 leads vencidos aguardam o fluxo novo&lt;/li&gt;&lt;li&gt;auto-descarte 10h seg–sex: INICIO +15d sem resposta → card 53 + SEM_RESPOSTA&lt;/li&gt;&lt;li&gt;varredura de lojas 10h (todo dia) → Excel parcial + fila_disparo (4.777 na fila)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="60" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_interessado" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;nudge 12h (Vercel): conversa parada 3–24h → cutucada contextual (máx 2)&lt;/li&gt;&lt;li&gt;reativação 10h: parado 48h–14d → HSM 48 (20/execução)&lt;/li&gt;&lt;li&gt;reengajamento 16h seg–sex: follow-up personalizado via HSM 48, até 3× a cada 15d&lt;/li&gt;&lt;li&gt;régua-saída 10h30: 3 reengajamentos + 15d mudo + bola com o lead → card 53 + SEM_RESPOSTA&lt;/li&gt;&lt;li&gt;auto-descarte: INTERESSADO +21d sem msg do lead → AGUARDANDO&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="332" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_pre" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Nenhuma cobrança automática nessa etapa (espera humana)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="604" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_cadastro" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;cadastro-recebido-cobranca 15h seg–sex: D+1 · D+3 · D+7 na etapa → HSM 48 + pede o dado que falta (um por vez)&lt;/li&gt;&lt;li&gt;Fonte da verdade = etapa do Evo (stagebegintime)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="876" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_analise" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;followup-fase 13h: 24h+ sem resposta → HSM 48 com miolo gerado pela Claude; máx 3 → escala Nei&lt;/li&gt;&lt;li&gt;Respeita [PAUSA_ATE] e acionar_humano&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="1148" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_treinar" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;treinar-primeira-venda: disparo sob demanda (não é cron) — pergunta se já vendeu&lt;/li&gt;&lt;li&gt;Lembretes de treinamento: scripts pontuais (ex.: aviso de feriado 04/09)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="1420" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_login" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;sla-liberacao: digest de lojas paradas em Treinar/Login — ⏸ desativado 06/08 (sob demanda)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="1692" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="rotinas_vendendo" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;consultoria-vendas 14h seg–sex: D+7 e depois a cada 15d, 4 toques via HSM 48&lt;/li&gt;&lt;li&gt;check-primeira-venda terças 10h: loja quieta 7d+ → "a primeira venda saiu?" (máx 2, 30d)&lt;/li&gt;&lt;li&gt;portal-aiva 6h todo dia: ativa loja (CNPJ registrado + Ativo no portal) + desempenho diário&lt;/li&gt;&lt;li&gt;pulso semanal segunda 8h30: fecha a semana e manda mensagens segmentadas às lojas ativas&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F6E63;fontFamily=Helvetica;" vertex="1" parent="lane_rotinas"><mxGeometry x="1964" y="14" width="250" height="242" as="geometry"/></mxCell>
<mxCell id="lane_sistemas" value="🗂 Sistemas e dados" style="swimlane;horizontal=0;startSize=40;html=1;fillColor=#E7EAEE;strokeColor=#3E4A57;fontColor=#3E4A57;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="1068" width="2528" height="170" as="geometry"/></mxCell>
<mxCell id="sistemas_inicio" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;sdr_leads (status INICIO) · fila_disparo · sdr_mensagens&lt;/li&gt;&lt;li&gt;Validação de WhatsApp do Evo (checkIfUserExists) fora do ar → sem checagem prévia&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="60" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_interessado" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;BrasilAPI (Receita): idade, situação, QSA — marcador [CNPJ_RECEITA] impede revalidar&lt;/li&gt;&lt;li&gt;aiva_base_cnpjs (6.323 CNPJs, importada 11h todo dia via Data Studio)&lt;/li&gt;&lt;li&gt;sdr_registros_cnpj (status informada) · formsdata da opp no Evo&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="332" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_pre" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Planilha AIVA APROVAÇÃO (Google Sheets) — linha por lead pré-aprovado&lt;/li&gt;&lt;li&gt;Tags Evo: AIVA (69) sempre · IMPORTANTE (74) se ≥ 3 lojas&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="604" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_cadastro" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;HubSpot (contato/empresa) — só quando os 12 dados fecham&lt;/li&gt;&lt;li&gt;sdr_registros_cnpj (matriz + adicionais) · formsdata da opp&lt;/li&gt;&lt;li&gt;Painel /registros&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="876" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_analise" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Onboarding AIVA (retail-onboarding-hub) + CAF (biometria)&lt;/li&gt;&lt;li&gt;sdr_chamados (erro relatado + print) → planilha Chamados&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="1148" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_treinar" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Drive AIVA (materiais + vídeos Flexfone) · Google Meet&lt;/li&gt;&lt;li&gt;Apps Script "AIVA Docs" (linha/senha/atendimento manual)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="1420" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_login" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Flexfone (plataforma da loja) · clientes.aivapay.com.br (2ª via)&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="1692" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="sistemas_vendendo" value='&lt;ul style="margin:0;padding-left:14px"&gt;&lt;li&gt;Portal Parceiros AIVA → aiva_portal_diario (fonte) → aiva_desempenho (mês/semana)&lt;/li&gt;&lt;li&gt;sdr_repasses_solicitados → planilha Repasses · contas MRR no Evo&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=4;fontSize=9;fillColor=#FFFFFF;strokeColor=#3E4A57;fontFamily=Helvetica;" vertex="1" parent="lane_sistemas"><mxGeometry x="1964" y="14" width="250" height="142" as="geometry"/></mxCell>
<mxCell id="e15" value="CNPJ &lt; 1 ano" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#8C2F2F;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="victoria_interessado" target="saida_2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="já cliente AIVA/Odres" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#8C2F2F;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="victoria_interessado" target="saida_3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="bot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#8C2F2F;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="victoria_inicio" target="saida_1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" value="Início +15d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontSize=10;strokeColor=#8C2F2F;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rotinas_inicio" target="saida_0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lane_trans" value="🔗 Transversal — corre o funil inteiro" style="swimlane;horizontal=0;startSize=40;html=1;fillColor=#F1EFE8;strokeColor=#4F4A3A;fontColor=#4F4A3A;fontStyle=1;fontSize=12;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="1250" width="2528" height="150" as="geometry"/></mxCell>
<mxCell id="trans_0" value='&lt;b&gt;🔁 Sincronização Evo ↔ painel&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Cada etapa tem uma automação de entrada que chama /opportunity-stage (≈1 s). Reforço: sync-from-evo a cada 5 min, Evo é a fonte da verdade (exceções: descarte manual, terminais, guarda de 2 min).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="60" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_1" value='&lt;b&gt;🛠 Auto-reprocess (10 min)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Mensagem do lead sem resposta da VictorIA → reprocessa; falha da Claude → até N tentativas e depois escala humano.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="368" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_2" value='&lt;b&gt;👤 Fila humana&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;acionar_humano=true entra na fila: 🔴 ação · 📄 docs · 🟡 mover card. WhatsApp pro Nei 8h seg–sex + painel /atendimento (chamados, CS, travados, CNPJ).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="676" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_3" value='&lt;b&gt;📋 Chamados&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Erro relatado → pede print → sdr_chamados + planilha Chamados. Nei clica Resolver → planilha recebe "sim" e o chamado some.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="984" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_4" value='&lt;b&gt;📣 Alertas&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Transições de status alertam Nei/Aldo via WhatsApp (pré-aprovação, cadastro ✅, CAF confirmado, loja sem operar, contato a confirmar).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="1292" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_5" value='&lt;b&gt;📰 Briefings&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;briefing-pipeline 5h seg–sex (Aldo + Nei) · auditoria Evo × Supabase (só alerta) · destilador semanal sex 10h (curadoria).&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="1600" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_6" value='&lt;b&gt;🧠 VictorIA Analista&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Widget do painel: consulta leads, conversas, chamados, repasses, desempenho semanal e curadoria. Só leitura.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="1908" y="14" width="286" height="122" as="geometry"/></mxCell>
<mxCell id="trans_7" value='&lt;b&gt;🗓 Data injetada a cada turno&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;A VictorIA não sabe o dia — lib/claude.ts injeta a data BRT fora do cache. Feriados/avisos entram como bloco dinâmico.&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=5;fontSize=9;fillColor=#FFFFFF;strokeColor=#4F4A3A;" vertex="1" parent="lane_trans"><mxGeometry x="2216" y="14" width="286" height="122" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
