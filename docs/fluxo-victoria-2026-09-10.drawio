<mxCell id="evo_login" value='&lt;b style="font-size:13px"&gt;71 · Login&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#4A5560"&gt;automação 91 → /opportunity-stage&lt;/span&gt;&lt;hr size="1"&gt;&lt;span style="font-size:10px"&gt;Nei move quando o login sai&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#FFFFFF;strokeColor=#1F4E8C;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="lane_evo"><mxGeometry x="1692" y="18" width="250" height="94" as="geometry"/></mxCell>
